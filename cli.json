{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode"
  },
  "keybinds": {
    "input.undo": "ctrl+-,super+z,option+z"
  },
  "scroll": {
    "speed": 6,
    "acceleration": true
  },
  "prompt": {
    "paste": "full"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
